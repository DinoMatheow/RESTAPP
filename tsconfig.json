{
  "include": [
    "src/**/*.ts",
    "setupTests.ts",
    "test/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "prisma", "prisma.config.ts"],
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "types": ["node", "jest"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}